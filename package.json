{
  "name": "sculpt",
  "version": "0.1.9",
  "description": "Library for transforming structured data through rules and relationships.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./transforms": {
      "import": {
        "types": "./dist/transforms.d.ts",
        "default": "./dist/transforms.js"
      },
      "require": {
        "types": "./dist/transforms.d.cts",
        "default": "./dist/transforms.cjs"
      }
    },
    "./derivations": {
      "import": {
        "types": "./dist/derivations.d.ts",
        "default": "./dist/derivations.js"
      },
      "require": {
        "types": "./dist/derivations.d.cts",
        "default": "./dist/derivations.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "biome": "biome check",
    "check": "npm run typecheck && npm test && npm run biome && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "vitest": "^5.0.4"
  },
  "private": true
}
